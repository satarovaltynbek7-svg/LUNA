generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  USER
  ADMIN
}

enum ReviewStatus {
  PENDING
  APPROVED
  REJECTED
}

enum OrderStatus {
  NEW
  CONFIRMED
  PREPARING
  READY
  COMPLETED
  CANCELLED
}

enum ReservationStatus {
  PENDING
  CONFIRMED
  REJECTED
  COMPLETED
}

model User {
  id           String               @id @default(uuid()) @db.Uuid
  fullName     String               @db.VarChar(100)
  email        String               @unique @db.VarChar(320)
  passwordHash String?
  googleId     String?              @unique
  avatar       String?
  role         UserRole             @default(USER)
  sessionVersion Int                @default(0)
  reviews      Review[]
  resetTokens  PasswordResetToken[]
  orders       CafeOrder[]
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt

  @@index([role])
}

model MenuCategory {
  id        String     @id @default(uuid()) @db.Uuid
  slug      String     @unique @db.VarChar(60)
  names     Json
  sortOrder Int        @default(0)
  active    Boolean    @default(true)
  items     MenuItem[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  @@index([active, sortOrder])
}

model MenuItem {
  id          String         @id @default(uuid()) @db.Uuid
  slug        String         @unique @db.VarChar(80)
  categoryId  String         @db.Uuid
  names       Json
  descriptions Json
  price       Int
  imageUrl    String         @db.VarChar(2048)
  isPopular   Boolean        @default(false)
  active      Boolean        @default(true)
  sortOrder   Int            @default(0)
  category    MenuCategory   @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  orderLines  OrderLine[]
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@index([categoryId, active, sortOrder])
  @@index([active, isPopular])
}

model CafeOrder {
  id          String       @id @default(uuid()) @db.Uuid
  userId      String?      @db.Uuid
  tableNumber Int?
  customerName String?     @db.VarChar(100)
  customerPhone String?    @db.VarChar(24)
  address      String?     @db.VarChar(300)
  note        String?      @db.VarChar(500)
  status      OrderStatus  @default(NEW)
  total       Int
  user        User?        @relation(fields: [userId], references: [id], onDelete: SetNull)
  lines       OrderLine[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@index([status, createdAt(sort: Desc)])
  @@index([createdAt(sort: Desc)])
}

model OrderLine {
  id          String     @id @default(uuid()) @db.Uuid
  orderId     String     @db.Uuid
  menuItemId  String?    @db.Uuid
  itemNames   Json
  unitPrice   Int
  quantity    Int
  lineTotal   Int
  order       CafeOrder  @relation(fields: [orderId], references: [id], onDelete: Cascade)
  menuItem    MenuItem?  @relation(fields: [menuItemId], references: [id], onDelete: SetNull)
}

model Reservation {
  id              String            @id @default(uuid()) @db.Uuid
  customerName    String            @db.VarChar(80)
  phone           String            @db.VarChar(24)
  dateTime        DateTime
  guestCount      Int
  specialRequests String?           @db.VarChar(400)
  status          ReservationStatus @default(PENDING)
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  @@index([status, dateTime])
}

model GalleryImage {
  id        String   @id @default(uuid()) @db.Uuid
  imageUrl  String   @db.VarChar(2048)
  category  String   @db.VarChar(30)
  captions  Json
  altTexts  Json
  active    Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([active, category, sortOrder])
}

model SiteContent {
  id        String   @id @default(uuid()) @db.Uuid
  key       String   @unique @db.VarChar(80)
  value     Json
  updatedAt DateTime @updatedAt
}

model PromotionalBanner {
  id        String    @id @default(uuid()) @db.Uuid
  titles    Json
  messages  Json
  imageUrl  String?   @db.VarChar(2048)
  linkUrl   String?   @db.VarChar(2048)
  active    Boolean   @default(false)
  startsAt  DateTime?
  endsAt    DateTime?
  sortOrder Int       @default(0)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([active, sortOrder])
}

model Review {
  id         String       @id @default(uuid()) @db.Uuid
  userId     String       @db.Uuid
  rating     Int
  text       String       @db.VarChar(1000)
  status     ReviewStatus @default(PENDING)
  isFeatured Boolean      @default(false)
  user       User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt

  @@index([status, createdAt(sort: Desc)])
  @@index([status, isFeatured, createdAt(sort: Desc)])
  @@index([userId, createdAt(sort: Desc)])
  @@index([rating, status])
}

model PasswordResetToken {
  id        String   @id @default(uuid()) @db.Uuid
  tokenHash String   @unique @db.VarChar(64)
  userId    String   @db.Uuid
  expiresAt DateTime
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
}
